    "url": "https://github.com/brunavaladares/verzel-store-qa/issues"
  },
  "homepage": "https://github.com/brunavaladares/verzel-store-qa#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
